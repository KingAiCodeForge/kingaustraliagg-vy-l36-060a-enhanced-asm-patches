# This is a local-first reverse-engineering workspace. GitHub receives only
# the explicitly reviewed files below. Research, source BIN/XDF/ADX files,
# generated disassembly, test images, logs, and superseded drafts stay local.
/*

!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/asm_wip/
!/tools/

# Public assembly patch catalog.
/asm_wip/*
!/asm_wip/README.md
!/asm_wip/ghost_cam/

/asm_wip/ghost_cam/*
!/asm_wip/ghost_cam/ghost_cam_retarded_idle_selector_v1.asm
!/asm_wip/ghost_cam/manifest.json
!/asm_wip/ghost_cam/README.md

# Public tools required to reproduce the static patch contracts.
/tools/*
!/tools/party_patch_tool.py
!/tools/safe_outputs.py
!/tools/test_party_patch_tool.py
!/tools/vy_flash_checksum.py
!/tools/test_vy_flash_checksum.py
!/tools/split_and_disassemble.py
!/tools/test_split_and_disassemble.py
